{
  "name": "chatcraft-electron",
  "version": "1.0.0",
  "description": "AI-powered chat enhancement desktop app",
  "main": "public/electron.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev-react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev-react": "react-scripts start",
    "build": "react-scripts build",
    "build-electron": "electron-builder",
    "dist": "npm run build && electron-builder",
    "dist-mac": "npm run build && electron-builder --mac",
    "dist-win": "npm run build && electron-builder --win",
    "dist-all": "npm run build && electron-builder --mac --win --linux",
    "dist-linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "electron",
    "react",
    "openai",
    "grammar",
    "chat"
  ],
  "author": {
    "name": "ChatCraft Team",
    "email": "contact@chatcraft.app"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^42.11.16",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^8.2.0",
    "openai": "^4.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "homepage": "./",
  "build": {
    "appId": "com.chatcraft.app",
    "productName": "ChatCraft",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "public/electron.js",
      "src/preload.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "node-forge": "^1.4.3",
    "minimatch": "^9.0.7",
    "glob": "^10.5.0",
    "qs": "^6.16.1",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.3",
    "fast-uri": "^3.1.9",
    "body-parser": "^1.20.9",
    "launch-editor": "^2.14.2",
    "source-map-js": "^1.2.2",
    "proxy-addr": "^2.0.8",
    "joi": "^17.13.8",
    "compression": "^1.8.2",
    "brace-expansion": "^2.1.7",
    "webpack-dev-middleware": "^7.4.6",
    "js-yaml": "^4.3.2",
    "svgo": "^2.8.4",
    "@xmldom/xmldom": "^0.8.15",
    "colord": "^2.9.4",
    "baseline-browser-mapping": "^2.11.0",
    "nanoid": "^3.3.18",
    "browserslist": "^4.28.7",
    "postcss": "^8.5.23",
    "builder-util-runtime": "^9.7.0",
    "app-builder-lib": "^26.15.0",
    "webpack-dev-server": "^5.2.6",
    "tar": "^7.5.18",
    "shell-quote": "^1.9.0",
    "websocket-driver": "^0.7.5",
    "http-proxy-middleware": "^2.0.10",
    "form-data": "^3.0.5",
    "@babel/core": "^7.29.6",
    "ws": "^7.5.11",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@tootallnate/once": "^2.0.1",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "follow-redirects": "^1.16.0",
    "lodash": "^4.18.0",
    "path-to-regexp": "^0.1.13",
    "picomatch": "^2.3.2",
    "yaml": "^2.8.3",
    "flatted": "^3.4.2",
    "underscore": "^1.13.8",
    "rollup": "^2.80.0",
    "jsonpath": "^1.3.0",
    "webpack": "^5.104.1",
    "nth-check": "^2.0.1"
  }
}
